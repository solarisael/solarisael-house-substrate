# Copy this file to .env inside WSL and edit secrets locally; never commit .env.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=solarisael
PGPASSWORD=replace-me
PGDATABASE=solarisael_memory

# Ollama must serve this endpoint and model inside the supported WSL path.
SOLARISAEL_EMBED_URL=http://127.0.0.1:11434/api/embed
SOLARISAEL_EMBED_MODEL=qwen3-embedding:4b
SOLARISAEL_EMBED_DIMENSION=2560

# Number of custom-format dumps retained by backup.sh.
KEEP=14
